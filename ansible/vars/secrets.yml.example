---
# Copy to vars/secrets.yml and fill in real values.
# NEVER commit secrets.yml to git — it is listed in .gitignore.
#
# After filling in values, run:
#   vagrant provision k3s-server --provision-with seal-secrets
# or inside the VM:
#   ansible-playbook /vagrant/ansible/playbooks/seal-secrets.yml --connection=local

# ── GitHub token for pushing sealed secrets to vroom-gitops ───────────────
# Classic PAT with repo scope: https://github.com/settings/tokens
github_gitops_token: "ghp_REPLACE_ME"
github_gitops_repo: "Ama2352/vroom-gitops"

# ── DB secrets — one entry per (namespace, service) combo ─────────────────
# user:     user_svc     → schema: users
# ride:     ride_svc     → schema: rides
# notification: notification_svc → schema: notifications
db_secrets:
  # vroom-dev
  - { namespace: vroom-dev,     name: user-db-secrets,         user: user_svc,         password: "changeme_dev_user" }
  - { namespace: vroom-dev,     name: ride-db-secrets,         user: ride_svc,         password: "changeme_dev_ride" }
  - { namespace: vroom-dev,     name: notification-db-secrets, user: notification_svc, password: "changeme_dev_notif" }
  # vroom-staging
  - { namespace: vroom-staging, name: user-db-secrets,         user: user_svc,         password: "changeme_stg_user" }
  - { namespace: vroom-staging, name: ride-db-secrets,         user: ride_svc,         password: "changeme_stg_ride" }
  - { namespace: vroom-staging, name: notification-db-secrets, user: notification_svc, password: "changeme_stg_notif" }
  # vroom-prod
  - { namespace: vroom-prod,    name: user-db-secrets,         user: user_svc,         password: "changeme_prod_user" }
  - { namespace: vroom-prod,    name: ride-db-secrets,         user: ride_svc,         password: "changeme_prod_ride" }
  - { namespace: vroom-prod,    name: notification-db-secrets, user: notification_svc, password: "changeme_prod_notif" }
  # platform (Postgres init — creates DB users/schemas)
  - { namespace: platform,      name: user-db-secrets,         user: user_svc,         password: "changeme_dev_user" }
  - { namespace: platform,      name: ride-db-secrets,         user: ride_svc,         password: "changeme_dev_ride" }
  - { namespace: platform,      name: notification-db-secrets, user: notification_svc, password: "changeme_dev_notif" }

# ── AlertManager ──────────────────────────────────────────────────────────
# Get URL from: Slack → Your apps → Incoming Webhooks
alertmanager_slack_webhook_url: "https://hooks.slack.com/services/REPLACE/ME"

# ── n8n ───────────────────────────────────────────────────────────────────
# Generate: PASS=$(openssl rand -base64 16); KEY=$(openssl rand -hex 32)
n8n_admin_password: "changeme"
n8n_encryption_key: "changeme_32_hex_chars_run_openssl_rand_hex_32"

# ── kubectl-executor ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
# Save this — you'll need it in the n8n workflow HTTP header config.
kubectl_executor_api_key: "changeme"
kubectl_executor_allowed_namespaces: "vroom-dev,vroom-staging,vroom-prod,platform,monitoring"

# ── Kargo admin ───────────────────────────────────────────────────────────
# Generate hash: htpasswd -bnBC 10 "" "yourpassword" | tr -d ':\n'
# Generate key:  openssl rand -base64 32
kargo_admin_password_hash: "$2b$10$REPLACE_WITH_BCRYPT_HASH"
kargo_admin_token_signing_key: "changeme_base64_signing_key"

# ── Kargo Git credentials (vroom namespace) ───────────────────────────────
gitops_git_creds_username: "Ama2352"
gitops_git_creds_password: "ghp_REPLACE_ME"   # same PAT as github_gitops_token
gitops_git_creds_url: "https://github.com/Ama2352/vroom-gitops.git"

# ── GHCR credentials (Kargo image polling) ────────────────────────────────
# PAT with read:packages scope
ghcr_creds_username: "Ama2352"
ghcr_creds_password: "ghp_REPLACE_ME"
